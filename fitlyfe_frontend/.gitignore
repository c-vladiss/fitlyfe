# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Environment / build config — never commit real values
# Copy the .example file and fill in your values locally
lib/config/dev.json
lib/config/prod.json
config/dev.json
config/prod.json

*.lock
# Google OAuth credential files — provided via CI/CD secrets
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
ios/Runner/google_clientid_apple.plist
ios/Flutter/GoogleOAuth.xcconfig

# Flutter tool metadata
.metadata
devtools_options.yaml
analysis_output.txt

# GraphQL generated Dart files (schema.graphql and operations/*.graphql are committed)
lib/graphql/*.graphql.dart
lib/graphql/**/*.graphql.dart
