extend type Query {
    # Most recent sessions first. limit defaults to 10, max 100.
    workoutSessions(limit: Int): [WorkoutSession!]!
}

extend type Mutation {
    # Saves a finished workout (session, exercises and sets) in one transaction.
    # Exercises are matched to the catalog by name (case-insensitive) and
    # added to it when new.
    logWorkoutSession(input: LogWorkoutSessionInput!): WorkoutSession!
    deleteWorkoutSession(id: ID!): Boolean!
}

input LogWorkoutSessionInput {
    # Optional idempotency key (a UUID generated by the client). Logging again
    # with the same clientId returns the already-saved session instead of
    # creating a duplicate, so clients can safely retry after network errors.
    clientId: ID
    # ISO-8601 timestamps. Include an offset (e.g. 2025-01-01T08:00:00Z);
    # values without one are treated as UTC.
    startedAt: String!
    endedAt: String!
    workoutType: String
    caloriesBurned: Int
    notes: String
    exercises: [LoggedExerciseInput!]!
}

input LoggedExerciseInput {
    name: String!
    notes: String
    sets: [LoggedSetInput!]!
}

input LoggedSetInput {
    reps: Int
    weightKg: Float
    durationSeconds: Int
    distanceMeters: Float
}

type WorkoutSession {
    id: ID!
    # ISO-8601 in UTC, e.g. 2025-01-01T08:00Z
    startedAt: String
    endedAt: String
    durationSeconds: Int
    workoutType: String
    caloriesBurned: Int
    notes: String
    exercises: [WorkoutExercise!]!
}

type WorkoutExercise {
    id: ID!
    exercise: Exercise!
    orderIndex: Int
    notes: String
    sets: [ExerciseSet!]!
}

type Exercise {
    id: ID!
    name: String!
    description: String
    muscleGroup: String
    equipment: String
}

type ExerciseSet {
    id: ID!
    setNumber: Int
    reps: Int
    weightKg: Float
    durationSeconds: Int
    distanceMeters: Float
}
