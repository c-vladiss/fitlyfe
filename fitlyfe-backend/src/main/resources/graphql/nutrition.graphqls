# ===========================================================================
# Nutrition tracking — daily nutrition logs, meals, and meal entries
# ===========================================================================

extend type Query {
    dailyNutrition(date: String!): DailyNutrition
}

type DailyNutrition {
    id: ID!
    date: String!
    totalCalories: Int
    proteinG: Float
    carbsG: Float
    fatG: Float
    waterMl: Int
    meals: [Meal!]!
}

type Meal {
    id: ID!
    mealType: String
    loggedAt: String
    entries: [MealEntry!]!
}

type MealEntry {
    id: ID!
    foodEntry: FoodEntry!
    quantityG: Float
    calories: Int
    proteinG: Float
    carbsG: Float
    fatG: Float
}
