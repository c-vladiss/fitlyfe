# ===========================================================================
# Nutrition tracking — daily nutrition logs, meals, and meal entries
# ===========================================================================

extend type Query {
    dailyNutrition(date: String!): DailyNutrition
    weeklyNutrition(startDate: String!, endDate: String!): [DailyNutrition!]!
    userMealTypes: [UserMealType!]!
}

extend type Mutation {
    # -- Template management (settings screen) --
    createUserMealTypes(types: [MealTypeInput!]!): [UserMealType!]!
    addUserMealType(name: String!, sortOrder: Int!): UserMealType!
    updateUserMealType(id: ID!, name: String, sortOrder: Int): UserMealType!
    deleteUserMealType(id: ID!): Boolean!

    # -- Per-day meal management --
    addMealToDay(date: String!, mealType: String!): Meal!
    renameMealOnDay(mealId: ID!, newName: String!): Meal!
    deleteMealFromDay(mealId: ID!): Boolean!

    # -- Meal entry CRUD --
    addMealEntry(date: String!, mealType: String!, foodEntryId: ID!, quantityG: Float!): MealEntry!
    updateMealEntry(entryId: ID!, quantityG: Float, foodEntryId: ID): MealEntry!
    deleteMealEntry(entryId: ID!): Boolean!
}

type DailyNutrition {
    id: ID!
    date: String!
    totalCalories: Int
    proteinG: Float
    carbsG: Float
    fatG: Float
    waterMl: Int
    meals: [Meal!]!
}

type Meal {
    id: ID!
    mealType: String
    loggedAt: String
    entries: [MealEntry!]!
}

type MealEntry {
    id: ID!
    foodEntry: FoodEntry!
    quantityG: Float
    calories: Int
    proteinG: Float
    carbsG: Float
    fatG: Float
}

type UserMealType {
    id: ID!
    name: String!
    sortOrder: Int!
    isDefault: Boolean!
}

input MealTypeInput {
    name: String!
    sortOrder: Int!
}
