# ===========================================================================
# Nutrition tracking — daily nutrition logs, meals, and meal entries
# ===========================================================================

extend type Query {
    # Returns daily nutrition for a date (initializes from template if day is pristine)
    dailyNutrition(date: String!): DailyNutrition!
    weeklyNutrition(startDate: String!, endDate: String!): [DailyNutrition!]!
    userMealTypes: [UserMealType!]!
}

extend type Mutation {
    # -- Template management (settings screen) --
    createUserMealTypes(types: [MealTypeInput!]!): [UserMealType!]!
    addUserMealType(name: String!, sortOrder: Int!): UserMealType!
    updateUserMealType(id: ID!, name: String, sortOrder: Int): UserMealType!
    deleteUserMealType(id: ID!): Boolean!

    # -- Per-day meal management --
    addMealToDay(date: String!, mealType: String!): Meal!
    renameMealOnDay(mealId: ID!, newName: String!): Meal!
    deleteMealFromDay(mealId: ID!): Boolean!

    # -- Meal entry CRUD --
    addMealEntry(date: String!, mealType: String!, foodEntryId: ID!, quantityG: Float!): AddMealEntryResponse!
    updateMealEntry(entryId: ID!, quantityG: Float, foodEntryId: ID): MealEntry!
    deleteMealEntry(entryId: ID!): Boolean!
}

type DailyNutrition {
    id: ID!
    date: String!
    # Consumed totals
    totalCalories: Int
    proteinG: Float
    carbsG: Float
    fatG: Float
    waterMl: Int
    # Goals (from user_goals, distributed per meal)
    goals: DailyGoals!
    # Meal template for this day with per-meal goals
    mealTemplate: [MealSlot!]!
    # Actual meals with entries
    meals: [Meal!]!
}

type DailyGoals {
    totalCalories: Int!
    totalProteinG: Float!
    totalCarbsG: Float!
    totalFatG: Float!
}

type MealSlot {
    name: String!
    sortOrder: Int!
    # Per-meal goals (total / number of meals)
    targetCalories: Int!
    targetProteinG: Float!
    targetCarbsG: Float!
    targetFatG: Float!
    # Consumed totals for this slot (sum of entries)
    consumedCalories: Int
    consumedProteinG: Float
    consumedCarbsG: Float
    consumedFatG: Float
    # Logged food entries (simplified for daily view)
    entries: [MealSlotEntry!]!
}

type MealSlotEntry {
    id: ID!
    name: String!
    quantityG: Float
    calories: Int
    proteinG: Float
    carbsG: Float
    fatG: Float
}

# Response for addMealEntry mutation
type AddMealEntryResponse {
    entry: MealEntry!
    mealSummary: MealSummary!
    dailySummary: DailySummary!
}

type MealSummary {
    mealId: ID!
    mealType: String!
    totalCalories: Int!
    proteinG: Float!
    carbsG: Float!
    fatG: Float!
}

type DailySummary {
    totalCaloriesConsumed: Int!
    proteinGConsumed: Float!
    carbsGConsumed: Float!
    fatGConsumed: Float!
}

type Meal {
    id: ID!
    mealType: String
    loggedAt: String
    entries: [MealEntry!]!
}

type MealEntry {
    id: ID!
    foodEntry: FoodEntry!
    quantityG: Float
    calories: Int
    proteinG: Float
    carbsG: Float
    fatG: Float
}

type UserMealType {
    id: ID!
    name: String!
    sortOrder: Int!
    isDefault: Boolean!
}

input MealTypeInput {
    name: String!
    sortOrder: Int!
}
