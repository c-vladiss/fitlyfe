# Copy this file to .env and fill in your values.
# .env is gitignored — never commit the real file.
#
# In production, set these as real environment variables (Kubernetes secrets,
# Docker env, your hosting provider's secret manager, etc.) — do not use .env.

# ── Database ──────────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/fitlyfe
DB_USERNAME=fitlyfe
DB_PASSWORD=fitlyfe

# ── Supabase ──────────────────────────────────────────────────────────────────
# Your Supabase project URL — used to build the JWKS endpoint for JWT validation.
# Format: https://<project-ref>.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# ── USDA FoodData Central ─────────────────────────────────────────────────────
# Free API key from https://fdc.nal.usda.gov/api-guide.html
# DEMO_KEY works for development but is rate-limited (30 req/hour, 50 req/day).
USDA_API_KEY=DEMO_KEY
